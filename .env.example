# Ambiente local com Docker. Em produção, use segredos do orquestrador.
GRANMAP_POSTGRES_PASSWORD=troque-por-um-segredo-longo
GRANMAP_ENVIRONMENT=development
GRANMAP_PUBLIC_ORIGINS=http://localhost:8080
GRANMAP_COOKIE_SECURE=false
GRANMAP_DATABASE_POOL_SIZE=3
GRANMAP_DATABASE_MAX_OVERFLOW=2
GRANMAP_DATABASE_POOL_TIMEOUT_SECONDS=10
GRANMAP_DATABASE_POOL_RECYCLE_SECONDS=300
GRANMAP_MINIMUM_APP_BUILD=5
GRANMAP_LATEST_APP_BUILD=6
GRANMAP_MAINTENANCE_MODE=false
GRANMAP_FEATURE_AR_ENABLED=true
GRANMAP_FEATURE_PHYSICAL_POSITIONING_ENABLED=true
GRANMAP_FEATURE_COMMUNITY_WRITES_ENABLED=true
GRANMAP_RETENTION_HISTORY_DAYS=180
GRANMAP_RETENTION_READ_NOTIFICATIONS_DAYS=90
GRANMAP_RETENTION_AUTH_EVENTS_DAYS=365
GRANMAP_RETENTION_FINGERPRINT_IDENTITY_DAYS=180
GRANMAP_SMTP_HOST=
GRANMAP_SMTP_PORT=587
GRANMAP_SMTP_USERNAME=
GRANMAP_SMTP_PASSWORD=
GRANMAP_SMTP_FROM_EMAIL=
GRANMAP_SMTP_STARTTLS=true
GRANMAP_COMMERCIAL_LAUNCH=false
GRANMAP_INSTITUTIONAL_MAP_APPROVED=false
GRANMAP_FIELD_CALIBRATION_COMPLETED=false

# Integrações institucionais. Deixe vazias na demo local.
GRANMAP_SSO_ISSUER_URL=
GRANMAP_SSO_CLIENT_ID=
GRANMAP_ERP_BASE_URL=
GRANMAP_ERP_API_TOKEN=
GRANMAP_PUSH_PROVIDER=
GRANMAP_PUSH_CREDENTIALS_CONFIGURED=false

# Produção atrás de HTTPS:
# GRANMAP_ENVIRONMENT=production
# GRANMAP_PUBLIC_ORIGINS=https://admin.seudominio.edu.br
# GRANMAP_COOKIE_SECURE=true
# Ative somente depois que /integrations/status retornar ready=true.
# GRANMAP_COMMERCIAL_LAUNCH=true
